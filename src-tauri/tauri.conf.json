{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dollie",
  "version": "0.2.1",
  "identifier": "com.dollie.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src https:",
      "capabilities": [
        "boot"
      ]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Dollie",
    "shortDescription": "Your Agency HQ for the AI Era",
    "longDescription": "Dollie is your agency headquarters - where all your agency knowledge connects to any AI tool. Manage clients, sites, and workflows from one place.",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "Developer ID Application: Bowe Frankema (TXKA6PVZ8N)",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "certificateThumbprint": null,
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "dollie"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk5NkZEODUzMThEQzNGNzAKUldSd1A5d1lVOWh2bWFWak95b3QxSTRkZ2pHYWJ2bEh5Y3BFTkFESll6c2c4VE1rRDgzTll6OGcK",
      "endpoints": [
        "https://github.com/DollieAI/dollie-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
